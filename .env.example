# ==============================================================================
# ResumeIQ — Environment Configuration Template
# ==============================================================================

# Application Environment ("development", "production", "test")
ENVIRONMENT=development
DEBUG=true

# Project Branding
PROJECT_NAME="AI Resume Analyzer & Job Matcher"
API_V1_STR="/api"

# Database Configuration (PostgreSQL with pgvector in production, SQLite fallback in local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumeiq
# SQLite dev fallback:
# DATABASE_URL=sqlite:///./resumeiq.db

# Redis Caching & Queue URL
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT)
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=dev-super-secret-jwt-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# AI PROVIDER CONFIGURATION
# ==============================================================================
# Options: "ollama" (local/offline) | "openai" (online OpenAI-compatible) | "mock"
AI_PROVIDER=ollama

# ==============================================================================
# LOCAL OLLAMA (AI_PROVIDER=ollama)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT=240.0
OLLAMA_MAX_RETRIES=1

# ==============================================================================
# ONLINE OPENAI-COMPATIBLE API (AI_PROVIDER=openai)
# Note: Resume/candidate evidence is sent to this endpoint only when AI_PROVIDER=openai.
# ==============================================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=60.0
OPENAI_MAX_RETRIES=2

# ==============================================================================
# AI FALLBACK BEHAVIOR
# ==============================================================================
# Keep false in production so unavailable local AI is reported clearly rather than
# silently replaced with MockAIProvider.
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=
AI_ALLOW_CLOUD_FALLBACK=false

# ==============================================================================
# HIGH-THROUGHPUT SCREENING & RERANKING
# ==============================================================================
MATCHING_TOP_K=100
AI_RERANK_TOP_K=20
MAX_CONCURRENT_RESUME_PROCESSING=4
AI_RERANK_MAX_TOKENS=450
UPLOAD_BATCH_SIZE=50

# ==============================================================================
# EMBEDDINGS
# ==============================================================================
# Options: "local" (1536-dim deterministic offline) | "openai" (cloud OpenAI-compatible)
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Scoring Engine Weights (must sum to 1.0)
WEIGHT_SKILLS=0.35
WEIGHT_EXPERIENCE=0.20
WEIGHT_SEMANTIC=0.20
WEIGHT_KEYWORDS=0.15
WEIGHT_EDUCATION=0.10

# Document Upload Limits
MAX_UPLOAD_SIZE_MB=5

# CORS Allowed Origins (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

